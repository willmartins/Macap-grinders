# Public site URL used for canonical links, sitemap and Open Graph.
# Do not point preview deployments at https://macap.it.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Sanity. The project id and dataset are public. Tokens are not.
NEXT_PUBLIC_SANITY_PROJECT_ID=u5o31ts3
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Contact form. All three are required before the form will send.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# Analytics. Leave blank to skip that service.
# If both GA and GTM are set, do not also fire GA from inside GTM or visits are counted twice.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Optional shared rate limit for the contact form. Without these, the limit is per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Cloudflare Turnstile. Set both, or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

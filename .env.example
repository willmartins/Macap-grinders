# Canonical origin for links, the sitemap and Open Graph.
# The live site's canonical host is https://macap.it. www.macap.it redirects there.
# Do not set this to a *.vercel.app host.
NEXT_PUBLIC_SITE_URL=https://macap.it

# Indexing stays off until launch.
# It turns on when this is true, or when VERCEL_ENV is production and the
# request host is the host of NEXT_PUBLIC_SITE_URL.
NEXT_PUBLIC_ALLOW_INDEXING=

# Sanity. The project id and dataset are public. Tokens are not.
NEXT_PUBLIC_SANITY_PROJECT_ID=u5o31ts3
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=
SANITY_REVALIDATE_SECRET=

# Enquiry form. All three are required before the form will send.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
# cc or bcc. Macap's inbox is copied on the distributor email. Defaults to cc.
CONTACT_DISTRIBUTOR_COPY=cc
# Optional. Mailing-list opt-ins are added to this Resend Audience.
RESEND_AUDIENCE_ID=

# Analytics. Leave blank to skip that service.
# If both GA and GTM are set, do not also fire GA from inside GTM or visits are counted twice.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Optional shared rate limit for the contact form. Without these, the limit is per server instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Cloudflare Turnstile. Set both, or neither.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
